{"\u041A\u043E\u0448\u043A\u0430":{"\u043A\u043E \u0448\u043A\u0430":{"\u043B\u0430\u0442":3},"\u0448\u043A\u0430 \u043B\u0430\u0442":{"\u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0435":3},"\u043B\u0430\u0442 \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0435":{"\u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435":3},"\u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435":{"\u043E\u0434\u043D\u043E":3},"\u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043E\u0434\u043D\u043E":{"\u0438\u0437":3},"\u043E\u0434\u043D\u043E \u0438\u0437":{"\u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435":3},"\u0438\u0437 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435":{"\u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B\u0445":3},"\u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B\u0445":{"\u043D\u0430\u0440\u044F\u0434\u0443":3},"\u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B\u0445 \u043D\u0430\u0440\u044F\u0434\u0443":{"\u0441":3},"\u043D\u0430\u0440\u044F\u0434\u0443 \u0441":{"\u0441\u043E\u0431\u0430\u043A\u043E\u0439":3},"\u0441 \u0441\u043E\u0431\u0430\u043A\u043E\u0439":{"\u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445":3},"\u0441\u043E\u0431\u0430\u043A\u043E\u0439 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445":{"\u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D\u043E\u0432":3},"\u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D\u043E\u0432":{"\u0441":3},"\u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D\u043E\u0432 \u0441":{"\u0442\u043E\u0447\u043A\u0438":3},"\u0441 \u0442\u043E\u0447\u043A\u0438":{"\u0437\u0440\u0435\u043D\u0438\u044F":3},"\u0442\u043E\u0447\u043A\u0438 \u0437\u0440\u0435\u043D\u0438\u044F":{"\u043D\u0430\u0443\u0447\u043D\u043E\u0439":3},"\u0437\u0440\u0435\u043D\u0438\u044F \u043D\u0430\u0443\u0447\u043D\u043E\u0439":{"\u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438":3},"\u043D\u0430\u0443\u0447\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438":{"\u0434\u043E\u043C\u0430\u0448\u043D\u044F\u044F":3},"\u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438 \u0434\u043E\u043C\u0430\u0448\u043D\u044F\u044F":{"\u043A\u043E\u0448\u043A\u0430":3},"\u0434\u043E\u043C\u0430\u0448\u043D\u044F\u044F \u043A\u043E\u0448\u043A\u0430":{"\u043C\u043B\u0435\u043A\u043E\u043F\u0438\u0442\u0430\u044E\u0449\u0435\u0435":3,"\u0438\u043B\u0438":3,"\u0431\u0443\u0434\u0435\u0442":3,"\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F":3,"\u0431\u044B\u043B\u0430":3},"\u043A\u043E\u0448\u043A\u0430 \u043C\u043B\u0435\u043A\u043E\u043F\u0438\u0442\u0430\u044E\u0449\u0435\u0435":{"\u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430":3},"\u043C\u043B\u0435\u043A\u043E\u043F\u0438\u0442\u0430\u044E\u0449\u0435\u0435 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430":{"\u043A\u043E\u0448\u0430\u0447\u044C\u0438\u0445":3},"\u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u043A\u043E\u0448\u0430\u0447\u044C\u0438\u0445":{"\u043E\u0442\u0440\u044F\u0434\u0430":3},"\u043A\u043E\u0448\u0430\u0447\u044C\u0438\u0445 \u043E\u0442\u0440\u044F\u0434\u0430":{"\u0445\u0438\u0449\u043D\u044B\u0445":3},"\u043E\u0442\u0440\u044F\u0434\u0430 \u0445\u0438\u0449\u043D\u044B\u0445":{"\u043E\u0434\u043D\u0438":3},"\u0445\u0438\u0449\u043D\u044B\u0445 \u043E\u0434\u043D\u0438":{"\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438":3},"\u043E\u0434\u043D\u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438":{"\u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442":3},"\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442":{"\u0434\u043E\u043C\u0430\u0448\u043D\u044E\u044E":3},"\u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442 \u0434\u043E\u043C\u0430\u0448\u043D\u044E\u044E":{"\u043A\u043E\u0448\u043A\u0443":3},"\u0434\u043E\u043C\u0430\u0448\u043D\u044E\u044E \u043A\u043E\u0448\u043A\u0443":{"\u043A\u0430\u043A":3},"\u043A\u043E\u0448\u043A\u0443 \u043A\u0430\u043A":{"\u043F\u043E\u0434\u0432\u0438\u0434":3},"\u043A\u0430\u043A \u043F\u043E\u0434\u0432\u0438\u0434":{"\u0434\u0438\u043A\u043E\u0439":3},"\u043F\u043E\u0434\u0432\u0438\u0434 \u0434\u0438\u043A\u043E\u0439":{"\u043A\u043E\u0448\u043A\u0438":3},"\u0434\u0438\u043A\u043E\u0439 \u043A\u043E\u0448\u043A\u0438":{"\u0434\u0440\u0443\u0433\u0438\u0435":3,"\u0438":3},"\u043A\u043E\u0448\u043A\u0438 \u0434\u0440\u0443\u0433\u0438\u0435":{"\u043A\u0430\u043A":3},"\u0434\u0440\u0443\u0433\u0438\u0435 \u043A\u0430\u043A":{"\u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439":3},"\u043A\u0430\u043A \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439":{"\u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439":3,"\u0432\u0438\u0434":3},"\u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439":{"\u0432\u0438\u0434":3},"\u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0432\u0438\u0434":{"\u044F\u0432\u043B\u044F\u044F\u0441\u044C":3},"\u0432\u0438\u0434 \u044F\u0432\u043B\u044F\u044F\u0441\u044C":{"\u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u043C":3},"\u044F\u0432\u043B\u044F\u044F\u0441\u044C \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u043C":{"\u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u043C":3},"\u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u043C \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u043C":{"\u043D\u0430":3},"\u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u043C \u043D\u0430":{"\u0433\u0440\u044B\u0437\u0443\u043D\u043E\u0432":3},"\u043D\u0430 \u0433\u0440\u044B\u0437\u0443\u043D\u043E\u0432":{"\u0438":6},"\u0433\u0440\u044B\u0437\u0443\u043D\u043E\u0432 \u0438":{"\u0434\u0440\u0443\u0433\u0438\u0445":6},"\u0438 \u0434\u0440\u0443\u0433\u0438\u0445":{"\u043C\u0435\u043B\u043A\u0438\u0445":3,"\u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445":3},"\u0434\u0440\u0443\u0433\u0438\u0445 \u043C\u0435\u043B\u043A\u0438\u0445":{"\u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445":3},"\u043C\u0435\u043B\u043A\u0438\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445":{"\u043A\u043E\u0448\u043A\u0430":3,"\u0432":3},"\u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043A\u043E\u0448\u043A\u0430":{"\u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435":3},"\u043A\u043E\u0448\u043A\u0430 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435":{"\u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435":3},"\u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435":{"\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0435\u0435":3},"\u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0435\u0435":{"\u0434\u043B\u044F":3},"\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0435\u0435 \u0434\u043B\u044F":{"\u043E\u0431\u0449\u0435\u043D\u0438\u044F":3},"\u0434\u043B\u044F \u043E\u0431\u0449\u0435\u043D\u0438\u044F":{"\u0448\u0438\u0440\u043E\u043A\u0438\u0439":3},"\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0448\u0438\u0440\u043E\u043A\u0438\u0439":{"\u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D":3},"\u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D":{"\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445":3},"\u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D \u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445":{"\u0441\u0438\u0433\u043D\u0430\u043B\u043E\u0432":3},"\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445 \u0441\u0438\u0433\u043D\u0430\u043B\u043E\u0432":{"\u0430":3},"\u0441\u0438\u0433\u043D\u0430\u043B\u043E\u0432 \u0430":{"\u0442\u0430\u043A\u0436\u0435":3},"\u0430 \u0442\u0430\u043A\u0436\u0435":{"\u0444\u0435\u0440\u043E\u043C\u043E\u043D\u044B":3,"\u0437\u0430":3,"\u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0435":3},"\u0442\u0430\u043A\u0436\u0435 \u0444\u0435\u0440\u043E\u043C\u043E\u043D\u044B":{"\u0438":3},"\u0444\u0435\u0440\u043E\u043C\u043E\u043D\u044B \u0438":{"\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F":3},"\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F":{"\u0442\u0435\u043B\u0430":3},"\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0442\u0435\u043B\u0430":{"\u0432":3},"\u0442\u0435\u043B\u0430 \u0432":{"\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435":3},"\u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435":{"\u0432\u0440\u0435\u043C\u044F":3},"\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F":{"\u0432":3},"\u0432\u0440\u0435\u043C\u044F \u0432":{"\u043C\u0438\u0440\u0435":3},"\u0432 \u043C\u0438\u0440\u0435":{"\u043D\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F":3},"\u043C\u0438\u0440\u0435 \u043D\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F":{"\u043E\u043A\u043E\u043B\u043E":3},"\u043D\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043E\u043A\u043E\u043B\u043E":{"600":3},"\u043E\u043A\u043E\u043B\u043E 600":{"\u043C\u043B\u043D":3},"600 \u043C\u043B\u043D":{"\u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445":3},"\u043C\u043B\u043D \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445":{"\u043A\u043E\u0448\u0435\u043A":3},"\u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445 \u043A\u043E\u0448\u0435\u043A":{"\u0432\u044B\u0432\u0435\u0434\u0435\u043D\u043E":3},"\u043A\u043E\u0448\u0435\u043A \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u043E":{"\u043E\u043A\u043E\u043B\u043E":3},"\u0432\u044B\u0432\u0435\u0434\u0435\u043D\u043E \u043E\u043A\u043E\u043B\u043E":{"200":3},"\u043E\u043A\u043E\u043B\u043E 200":{"\u043F\u043E\u0440\u043