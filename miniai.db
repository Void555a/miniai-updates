:2},"\u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u043E\u043C":{"\u043F\u0443\u0437\u044B\u0440\u0435":2},"\u043C\u0435\u0441\u0442\u043D\u043E\u043C \u043F\u0443\u0437\u044B\u0440\u0435":{"\u0437\u043E\u043D\u0435":2},"\u043F\u0443\u0437\u044B\u0440\u0435 \u0437\u043E\u043D\u0435":{"\u0440\u0430\u0441\u0441\u0435\u044F\u043D\u043D\u043E\u0433\u043E":2},"\u0437\u043E\u043D\u0435 \u0440\u0430\u0441\u0441\u0435\u044F\u043D\u043D\u043E\u0433\u043E":{"\u043C\u0435\u0436\u0437\u0432\u0451\u0437\u0434\u043D\u043E\u0433\u043E":2},"\u0440\u0430\u0441\u0441\u0435\u044F\u043D\u043D\u043E\u0433\u043E \u043C\u0435\u0436\u0437\u0432\u0451\u0437\u0434\u043D\u043E\u0433\u043E":{"\u0433\u0430\u0437\u0430":2},"\u043C\u0435\u0436\u0437\u0432\u0451\u0437\u0434\u043D\u043E\u0433\u043E \u0433\u0430\u0437\u0430":{"\u0438\u0437":2},"\u0433\u0430\u0437\u0430 \u0438\u0437":{"\u0437\u0432\u0451\u0437\u0434":2},"\u0437\u0432\u0451\u0437\u0434 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u0445":{"50":2},"\u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u0445 50":{"\u0441\u0430\u043C\u044B\u043C":2},"50 \u0441\u0430\u043C\u044B\u043C":{"\u0431\u043B\u0438\u0437\u043A\u0438\u043C":2},"\u0441\u0430\u043C\u044B\u043C \u0431\u043B\u0438\u0437\u043A\u0438\u043C":{"\u0437\u0432\u0451\u0437\u0434\u043D\u044B\u043C":2},"\u0431\u043B\u0438\u0437\u043A\u0438\u043C \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u043C":{"\u0441\u0438\u0441\u0442\u0435\u043C\u0430\u043C":2},"\u0437\u0432\u0451\u0437\u0434\u043D\u044B\u043C \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u043C":{"\u0432":2},"\u0441\u0438\u0441\u0442\u0435\u043C\u0430\u043C \u0432":{"\u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445":2},"\u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445":{"17":2},"\u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 17":{"\u0441\u0432\u0435\u0442\u043E\u0432\u044B\u0445":2},"17 \u0441\u0432\u0435\u0442\u043E\u0432\u044B\u0445