043C":{"\u043F\u043E\u0432\u043E\u0440\u043E\u0442":1},"\u043F\u0440\u0435\u0446\u0435\u0441\u0441\u0438\u043E\u043D\u043D\u044B\u043C \u043F\u043E\u0432\u043E\u0440\u043E\u0442":{"\u0431\u043E\u043B\u044C\u0448\u043E\u0439":1},"\u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0439":{"\u043E\u0441\u0438":1},"\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043E\u0441\u0438":{"\u043B\u0443\u043D\u043D\u043E\u0439":1},"\u043E\u0441\u0438 \u043B\u0443\u043D\u043D\u043E\u0439":{"\u043E\u0440\u0431\u0438\u0442\u044B":1},"\u043E\u0440\u0431\u0438\u0442\u044B \u043B\u0438\u043D\u0438\u0438":{"\u0430\u043F\u0441\u0438\u0434":1},"\u043B\u0438\u043D\u0438\u0438 \u0430\u043F\u0441\u0438\u0434":{"\u0441":1},"\u0430\u043F\u0441\u0438\u0434 \u0441":{"\u043F\u0435\u0440\u0438\u043E\u0434\u043E\u043C":1},"\u043F\u0435\u0440\u0438\u043E\u0434\u043E\u043C 8":{"8":1},"8 8":{"\u0433\u043E\u0434\u0430":1},"8 \u0433\u043E\u0434\u0430":{"\u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442":1},"\u0433\u043E\u0434\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442":{"\u0432":1},"\u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0432":{"\u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u043C":1}},"\u041C\u0443\u0437\u044B\u043A\u0430":{"\u043C\u0443 \u0437\u044B\u043A\u0430":{"\u043E\u0442":3,"\u0445\u043E\u0442\u044F":1},"\u0437\u044B\u043A\u0430 \u043E\u0442":{"\u0434\u0440":3},"\u043E\u0442 \u0434\u0440":{"\u0433\u0440\u0435\u0447":3},"\u0434\u0440 \u0433\u0440\u0435\u0447":{"\u0432\u0438\u0434":3,"\u0440\u0435\u043C\u0435\u0441\u043B\u043E":1},"\u0433\u0440\u0435\u0447 \u0432\u0438\u0434":{"\u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430":3},"\u0432\u0438\u0434 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430":{"\u0432":3},"\u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430 \u0432":{"\u043A\u043E\u0442\u043E\u0440\u043E\u043C":3},"\u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C":{"\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u043C":3},"\u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u043C":{"\u043E\u0431\u0440\u0430\u0437\u043E\u043C":3},"\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C":{"\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0435":3},"\u043E\u0431\u0440\u0430\u0437\u043E\u043C \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0435":{"\u0437\u0432\u0443\u043A\u0438":3},"\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u0437\u0432\u0443\u043A\u0438":{"\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F":3},"\u0437\u0432\u0443\u043A\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F":{"\u0434\u043B\u044F":3},"\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F \u0434\u043B\u044F":{"\u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F":3},"\u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F":{"\u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E":3},"\u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E":{"\u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u044F":3},"\u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u044F":{"\u0444\u043E\u0440\u043C\u044B":3},"\u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u044F \u0444\u043E\u0440\u043C\u044B":{"\u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0438":3},"\u0444\u043E\u0440\u043C\u044B \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0438":{"\u043C\u0435\u043B\u043E\u0434\u0438\u0438":3},"\u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0438 \u043C\u0435\u043B\u043E\u0434\u0438\u0438":{"\u0440\u0438\u0442\u043C\u0430":3},"\u043C\u0435\u043B\u043E\u0434\u0438\u0438 \u0440\u0438\u0442\u043C\u0430":{"\u0438\u043B\u0438":3},"\u0440\u0438\u0442\u043C\u0430 \u0438\u043B\u0438":{"\u0438\u043D\u043E\u0433\u043E":3},"\u0438\u043B\u0438 \u0438\u043D\u043E\u0433\u043E":{"\u0432\u044B\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E":3},"\u0438\u043D\u043E\u0433\u043E \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E":{"\u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F":3},"\u0432\u044B\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F":{"\u043F\u0440\u0438\u043D\u044F\u0442\u043E":3},"\u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F \u043F\u0440\u0438\u043D\u044F\u0442\u043E":{"\u0441\u0447\u0438\u0442\u0430\u0442\u044C":3},"\u043F\u0440\u0438\u043D\u044F\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u0442\u044C":{"\u0447\u0442\u043E":3},"\u0441\u0447\u0438\u0442\u0430\u0442\u044C \u0447\u0442\u043E":{"\u043C\u0443\u0437\u044B\u043A\u0430":3},"\u0447\u0442\u043E \u043C\u0443\u0437\u044B\u043A\u0430":{"\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F":3,"\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F":3},"\u043C\u0443\u0437\u044B\u043A\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F":{"\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E\u0439":3},"\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E\u0439":{"\u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u0438\u0435\u0439":3},"\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E\u0439 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u0438\u0435\u0439":{"\u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439":3},"\u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u0438\u0435\u0439 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439":{"\u0432\u043E":3},"\u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0432\u043E":{"\u0432\u0441\u0435\u0445":3},"\u0432\u043E \u0432\u0441\u0435\u0445":{"\u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445":3},"\u0432\u0441\u0435\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445":{"\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430\u0445":3},"\u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430\u0445":{"\u0435\u0451":3},"\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430\u0445 \u0435\u0451":{"\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F":3},"\u0435\u0451 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F":{"\u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E":3},"\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E":{"\u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F":3},"\u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F":{"\u043F\u043E":3},"\u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F \u043F\u043E":{"\u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044E":3},"\u043F\u043E \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044E":{"\u0438":3},"\u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044E \u0438":{"\u043F\u043E\u0434\u0445\u043E\u0434\u0443":3},"\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u0443":{"\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438":3},"\u043F\u043E\u0434\u0445\u043E\u0434\u0443 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438":{"\u043F\u0440\u0438\u0437\u043D\u0430\u044E\u0442":3},"\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u044E\u0442":{"\u0447\u0442\u043E":3},"\u043F\u0440\u0438\u0437\u043D\u0430\u044E\u0442 \u0447\u0442\u043E":{"\u043C\u0443\u0437\u044B\u043A\u0430":3},"\u043C\u0443\u0437\u044B\u043A\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F":{"\u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438":3},"\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438":{"\u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u043C\u0438":3},"\u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u043C\u0438":{"\u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438":3},"\u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u043C\u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438":{"\u0432\u044B\u0441\u043E\u0442\u043E\u0439":3},"\u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u0432\u044B\u0441\u043E\u0442\u043E\u0439":{"\u0442\u0435\u043C\u0431\u0440\u043E\u043C":3},"\u0432\u044B\u0441\u043E\u0442\u043E\u0439 \u0442\u0435\u043C\u0431\u0440\u043E\u043C":{"\u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E":3},"\u0442\u0435\u043C\u0431\u0440\u043E\u043C \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E":{"\u0444\u043E\u0440\u043C\u043E\u0439":3},"\u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E \u0444\u043E\u0440\u043C\u043E\u0439":{"\u0438":3},"\u0444\u043E\u0440\u043C\u043E\u0439 \u0438":{"\u0434\u0440":3},"\u0438 \u0434\u0440":{"\u043E\u0434\u043D\u0430\u043A\u043E":3},"\u0434\u0440 \u043E\u0434\u043D\u0430\u043A\u043E":{"\u0435\u0434\u0438\u043D\u043E\u0433\u043E":3},"\u043E\u0434\u043D\u0430\u043A\u043E \u0435\u0434\u0438\u043D\u043E\u0433\u043E":{"\u043C\u043D\u0435\u043D\u0438\u044F":3},"\u0435\u0434\u0438\u043D\u043E\u0433\u043E \u043C\u043D\u0435\u043D\u0438\u044F":{"\u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E":3},"\u043C\u043D\u0435\u043D\u0438\u044F \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E":{"\u0438\u0445":3},"\u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0438\u0445":{"\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0439":3},"\u0438\u0445 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0439":{"\u043D\u0435":3},"\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0439 \u043D\u0435":{"\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442":3},"\u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442":{"\u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435":3},"\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435":{"\u043C\u0443\u0437\u044B\u043A\u0438":3},"\u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u043C\u0443\u0437\u044B\u043A\u0438":{"\u043E\u0431\u044B\u0447\u043D\u043E":3},"\u043C\u0443\u0437\u044B\u043A\u0438 \u043E\u0431\u044B\u0447\u043D\u043E":{"\u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F":3},"\u043E\u0431\u044B\u0447\u043D\u043E \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F":{"\u043D\u0430":3},"\u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F \u043D\u0430":{"\u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0435":3},"\u043D\u0430 \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0435":{"\u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044E":3},"\u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044E":{"\u0438\u043C\u043F\u0440\u043E\u0432\u0438\u0437\u0430\u0446\u0438\u044E":3},"\u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044E \u0438\u043C\u043F\u0440\u043E\u0432\u0438\u0437\u0430\u0446\u0438\u044E":{"\u0438":3},"\u0438\u043C\u043F\u0440\u043E\u0432\u0438\u0437\u0430\u0446\u0438\u044E \u0438":{"\u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435":3},"\u0438 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435":{"\u0432":3},"\u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0432":{"\u0442\u043E":3},"\u0432 \u0442\u043E":{"\u0432\u0440\u0435\u043C\u044F":3},"\u0442\u043E \u0432\u0440\u0435\u043C\u044F":{"\u043A\u0430\u043A":3},"\u0432\u0440\u0435\u043C\u044F \u043A\u0430\u043A":{"\u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435":3},"\u043A\u0430\u043A \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435":{"\u0430\u0441\u043F\u0435\u043A\u0442\u044B":3},"\u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0430\u0441\u043F\u0435\u043A\u0442\u044B":{"\u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u043E\u0433\u043E":3},"\u0430\u0441\u043F\u0435\u043A\u0442\u044B \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u043E\u0433\u043E":{"\u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430":3},"\u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430":{"\u0438\u0437\u0443\u0447\u0430\u044E\u0442\u0441\u044F":3},"\u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430 \u0438\u0437\u0443\u0447\u0430\u044E\u0442\u0441\u044F":{"\u0432":3},"\u0438\u0437\u0443\u0447\u0430\u044E\u0442\u0441\u044F \u0432":{"\u0440\u0430\u043C\u043A\u0430\u0445":3},"\u0432 \u0440\u0430\u043C\u043A\u0430\u0445":{"\u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445":3},"\u0440\u0430\u043C\u043A\u0430\u0445 \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445":{"\u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D":3},"\u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u