":3},"\u043B\u0435\u0436\u0438\u0442 \u043F\u0440\u0430\u0438\u043D\u0434\u043E\u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0439":{"\u043A\u043E\u0440\u0435\u043D\u044C":3},"\u043F\u0440\u0430\u0438\u043D\u0434\u043E\u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u0435\u043D\u044C":{"\u043E\u0442":3},"\u043A\u043E\u0440\u0435\u043D\u044C \u043E\u0442":{"\u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E":3},"\u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E":{"\u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0438":3},"\u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0438":{"\u0433\u043B\u0430\u0433\u043E\u043B\u044B":3},"\u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0438 \u0433\u043B\u0430\u0433\u043E\u043B\u044B":{"\u0438\u043D\u0434\u043E\u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0445":3},"\u0433\u043B\u0430\u0433\u043E\u043B\u044B \u0438\u043D\u0434\u043E\u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0445":{"\u044F\u0437\u044B\u043A\u043E\u0432":3},"\u044F\u0437\u044B\u043A\u043E\u0432 \u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0449\u0438\u0435":{"\u043A\u043E\u0442\u0438\u0442\u044C\u0441\u044F":3},"\u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0449\u0438\u0435 \u043A\u043E\u0442\u0438\u0442\u044C\u0441\u044F":{"\u043F\u043E\u0437\u0434\u043D\u0435\u0435":3},"\u043A\u043E\u0442\u0438\u0442\u044C\u0441\u044F \u043F\u043E\u0437\u0434\u043D\u0435\u0435":{"\u043E\u0442":3},"\u043F\u043E\u0437\u0434\u043D\u0435\u0435 \u043E\u0442":{"\u043D\u0438\u0445":3},"\u043E\u0442 \u043D\u0438\u0445":{"\u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0438":3},"\u043D\u0438\u0445 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0438":{"\u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F":3},"\u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0438 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F":{"\u0434\u0435\u0442\u0451\u043D\u044B\u0448\u0435\u0439":3},"\u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u0434\u0435\u0442\u0451\u043D\u044B\u0448\u0435\u0439":{"\u043C\u0435\u043B\u043A\u0438\u0445":3},"\u0434\u0435\u0442\u0451\u043D\u044B\u0448\u0435\u0439 \u043C\u0435\u043B\u043A\u0438\u0445":{"\u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445":3},"\u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0432":{"\u0438\u043D\u0434\u043E\u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0445":3},"\u0432 \u0438\u043D\u0434\u043E\u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0445":{"\u044F\u0437\u044B\u043A\u0430\u0445":3},"\u0438\u043D\u0434\u043E\u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0445 \u044F\u0437\u044B\u043A\u0430\u0445":{"\u0434\u0440\u0443\u0433\u0438\u0435":3},"\u044F\u0437\u044B\u043A\u0430\u0445 \u0434\u0440\u0443\u0433\u0438\u0435":{"\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438":3},"\u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438":{"\u0441\u0447\u0438\u0442\u0430\u044E\u0442":3},"\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438 \u0441\u0447\u0438\u0442\u0430\u044E\u0442":{"\u0442\u0430\u043A\u0443\u044E":3},"\u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u0442\u0430\u043A\u0443\u044E":{"\u0441\u0432\u044F\u0437\u044C":3},"\u0442\u0430\u043A\u0443\u044E \u0441\u0432\u044F\u0437\u044C":{"\u0432\u0442\u043E\u0440\u0438\u0447\u043D\u044B\u043C":3},"\u0441\u0432\u044F\u0437\u044C \u0432\u0442\u043E\u0440\u0438\u0447\u043D\u044B\u043C":{"\u0441\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0435\u043C":3},"\u0432\u0442\u043E\u0440\u0438\u0447\u043D\u044B\u043C \u0441\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0435\u043C":{"\u0437\u0432\u0443\u043A\u043E\u043F\u043E\u0434\u0440\u0430\u0436\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438":3},"\u0441\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0435\u043C \u0437\u0432\u044