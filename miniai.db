u0438\u043B":{"\u043C\u043E\u0434\u0435\u043B\u044C":1},"\u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043C\u043E\u0434\u0435\u043B\u044C":{"\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F":1},"\u043C\u043E\u0434\u0435\u043B\u044C \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F":{"\u043B\u0443\u043D\u044B":1},"\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u043B\u0443\u043D\u044B":{"\u0432":1},"\u043B\u0443\u043D\u044B \u0432":{"\u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435":1},"\u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435":{"\u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439":1},"\u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439":{"\u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u043D\u043E\u0439":1},"\u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u043D\u043E\u0439":{"\u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0438\u0440\u043E\u0432\u043A\u0438":1},"\u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u043D\u043E\u0439 \u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0438\u0440\u043E\u0432\u043A\u0438":{"\u0437\u0435\u043C\u043B\u0438":1},"\u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0438\u0440\u043E\u0432\u043A\u0438 \u0437\u0435\u043C\u043B\u0438":{"\u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438":1},"\u0437\u0435\u043C\u043B\u0438 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438":{"\u0442\u0435\u043B\u0430\u043C\u0438":1},"\u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0442\u0435\u043B\u0430\u043C\u0438":{"\u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C":1},"\u0442\u0435\u043B\u0430\u043C\u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0